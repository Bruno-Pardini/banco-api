# ---------- PostgreSQL (lo usa el contenedor db) ----------
POSTGRES_USER=banco
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=banco
POSTGRES_PORT=5432

# ---------- API ----------
# Dentro de Docker el host es "db"; para correr la API fuera de Docker usa localhost.
DATABASE_URL=postgresql+asyncpg://banco:cambia-esta-contrasena@db:5432/banco
APP_ENV=development
API_PORT=8000
LOG_LEVEL=INFO
# Zona horaria del Banco: fecha_hora y fecha_hora_solicitud se guardan como TIMESTAMP sin zona en esta hora local.
ZONA_HORARIA=America/Hermosillo
# Orígenes permitidos para la IG 6.1 (separados por coma). Vacío = sin CORS.
CORS_ORIGINS=http://localhost:5173
# Al iniciar el contenedor: aplicar migraciones y cargar datos de demostración.
RUN_MIGRATIONS=true
SEED_DEMO=true
