# Para depurar la API desde VS Code (fuera de Docker) contra el PostgreSQL del docker compose.
# Copia a .env.local y usa la misma contraseña que pusiste en .env
DATABASE_URL=postgresql+asyncpg://banco:cambia-esta-contrasena@localhost:5432/banco
APP_ENV=development
LOG_LEVEL=DEBUG
ZONA_HORARIA=America/Hermosillo
CORS_ORIGINS=http://localhost:5173
